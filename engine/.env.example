# Copy this file to engine/.env and paste your key after the equals sign.
# Create a key at https://aistudio.google.com/apikey
# engine/.env is ignored by Git, so it stays on this computer.

GEMINI_API_KEY=

# Optional free-tier fallback: https://console.groq.com/keys
# With both keys set, Gemini is tried first and Groq handles temporary failures.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Disable fallback for provider checks or comparison experiments:
# CODESYNC_FALLBACK=0

# Optional: use another model. `codesync models` lists what is available.
# GEMINI_MODEL=

# Optional: use another provider: gemini (the default), groq, deepseek or ollama.
# CODESYNC_PROVIDER=ollama
# DEEPSEEK_API_KEY=
# OLLAMA_MODEL=deepseek-coder:6.7b
