# Copy this file to engine/.env and paste your key after the equals sign.
# Create a key at https://aistudio.google.com/apikey
# engine/.env is ignored by Git, so it stays on this computer.

GEMINI_API_KEY=

# Optional: use another model. `codesync models` lists what is available.
# GEMINI_MODEL=

# Optional: use another provider: gemini (the default), deepseek or ollama.
# CODESYNC_PROVIDER=ollama
# DEEPSEEK_API_KEY=
# OLLAMA_MODEL=deepseek-coder:6.7b
